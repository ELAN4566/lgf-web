[Unit]
Description=LGF-Websites aus dem GitHub-Build-Branch aktualisieren
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=lgfdeploy
Group=lgfdeploy
ExecStart=/opt/lgf-web-deploy-bin/lgf-web-deploy.sh
# Absicherung: nur Klon und Website-Ordner beschreibbar.
# "-" = Ordner darf fehlen (jeder Server hat nur seine Sites).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/lgf-web-deploy -/var/www/wortuhr -/var/www/mds -/var/www/mvs -/var/www/lgf
ProtectHome=read-only
PrivateTmp=yes
