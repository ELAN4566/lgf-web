---
import SiteLayout from '../layouts/SiteLayout.astro';
import Impressum from '@lgf/shared/components/legal/Impressum.astro';
import { site } from '../site.config';
---

<SiteLayout title="Impressum" hideAnnouncement>
  <section class="section">
    <div class="container">
      <h1>Impressum</h1>
      <Impressum site={site}>
        <h2>Schrift der Wortuhr-Buchstaben</h2>
        <p>
          Die Buchstaben der Wortuhr-Vorschau verwenden die Schrift «Nunito» (SIL Open Font License,
          <a href="/fonts/Nunito-OFL.txt">Lizenztext</a>).
        </p>
      </Impressum>
    </div>
  </section>
</SiteLayout>
