---
/**
 * Download: Installationsprogramme und PDFs bleiben auf dem Server
 * (nicht im Repo). Adressen wie bisher, damit bestehende Links funktionieren:
 *   /MdsClient           MDS Controller Installation (ClickOnce)
 *   /media/files/*.pdf   Dokumentation
 */
import SiteLayout from '../layouts/SiteLayout.astro';

const docs = [
  ['MDS Flyer', '/media/files/mds-faltflyer.pdf'],
  ['Benutzerhandbuch', '/media/files/mds-user-manual.pdf'],
  ['Hardwarebeschreibung', '/media/files/mds-hardware-manual.pdf'],
  ['Inbetriebnahmeanleitung MDS-Evaluationspaket', '/media/files/mds-evaluation-inbetriebnahmeanleitung.pdf'],
];
---

<SiteLayout title="Download" description="MDS Controller Software, MVS Applikation und Dokumentation zum Modellbahn Decoder System.">
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Download</span>
      <h1>Software und Dokumentation</h1>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div class="card dl">
        <h2>MDS Controller</h2>
        <p>
          Windows-Applikation für den Modellbahn-PC. Der Server läuft im Hintergrund, die
          Bedienoberfläche als Windows-Programm oder in jedem Browser auf PC, Tablet und Smartphone.
          Installation auf mehreren Rechnern möglich, Anmeldung mit Ihrem Benutzernamen.
        </p>
        <a class="btn btn--primary" href="/MdsClient">Installationsprogramm</a>
      </div>
      <div class="card dl">
        <h2>MVS Applikation</h2>
        <p>
          Für die Erfassung und Konfiguration aller Komponenten. Installation auf dem Modellbahn-PC
          und beliebigen weiteren Windows-Rechnern. <a href="https://mvs.lgf.ch">Mehr zu MVS</a>
        </p>
        <a class="btn btn--outline" href="https://mvs.lgf.ch/MvsClient/">Installationsprogramm</a>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="dokumentation">
    <div class="container">
      <h2 class="section-title">Dokumentation</h2>
      <p class="muted">Das gesamte MDS-System ist in der Dokumentation detailliert beschrieben.</p>
      <ul class="docs">
        {
          docs.map(([t, href]) => (
            <li>
              <a href={href}>
                <span class="docs__icon" aria-hidden="true">PDF</span>
                {t}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .dl h2 {
    font-size: 1.4rem;
  }
  .dl p {
    color: var(--muted);
  }
  .docs {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .docs a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
  }
  .docs a:hover {
    border-color: var(--brand);
  }
  .docs__icon {
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--brand);
    color: #fff;
    border-radius: 4px;
    padding: 0.3em 0.5em;
  }
</style>
