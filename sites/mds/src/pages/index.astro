---
/**
 * ENTWURF Startseite MDS – Texte aus der bisherigen Zeta-Producer-Site,
 * neu gegliedert. Detailseiten pro Produkt folgen (Artikelnummer = Adresse,
 * z. B. /hardware/mdlif5/ – später auch Schlüssel für den Shop).
 */
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import NewsList from '@lgf/shared/components/NewsList.astro';
import { getNewsForSite } from '@lgf/shared/lib/news.ts';
import { site } from '../site.config';

import heroImg from '../assets/bilder/mds-basis.png';
import systemImg from '../assets/bilder/mds-systemuebersicht.png';
import mdlif5 from '../assets/bilder/mdlif5_rev7.png';
import ifsnd1 from '../assets/bilder/ifsnd1_rev1.png';
import adsigh from '../assets/bilder/adsigh_rev6.png';
import gateway from '../assets/bilder/mds-gateway.png';
import software from '../assets/bilder/mds-software.png';

const news = (await getNewsForSite(site.id)).slice(0, 3);

const benefits = [
  { title: 'Modular', text: 'Basisdecoder mit steckbaren Modulen für maximale Flexibilität.' },
  { title: 'Drahtlos', text: 'Kommunikation über WLAN für Betrieb, Programmierung und Aktualisierung.' },
  { title: 'Mobil', text: 'Programmierung mit PC und/oder drahtlos über Tablet oder Smartphone.' },
  { title: 'Einfach', text: 'Dezentrale Platzierung ermöglicht minimalen Verkabelungsaufwand.' },
  { title: 'Integriert', text: 'Integrierte Programmierung, kein separates Programmiergerät erforderlich.' },
  { title: 'Zentral', text: 'Verwaltung und Basiskonfiguration aller Komponenten mit der MVS Applikation.' },
];

const hardware = [
  {
    img: mdlif5,
    title: 'Decoder',
    sub: 'MDLIF5 Universaldecoder',
    text: 'Ein Decodertyp für Weichen, Signale, Belegtmelder, Beleuchtung: 5 Steckplätze für Interface-Module, LEDBUS, WLAN.',
    href: '/hardware/#decoder',
  },
  {
    img: ifsnd1,
    title: 'Interface-Module',
    sub: 'über 15 Module',
    text: 'Servo, Motor, Magnet, Relais, Belegtmelder 2- und 3-Leiter, LED, Taster, Sound und Gateway zur Digitalzentrale.',
    href: '/hardware/#interface',
  },
  {
    img: adsigh,
    title: 'LEDBUS-Adapter',
    sub: 'Signale & Beleuchtung',
    text: 'Adressierbare LED für Signale, Einzel-LED, RGB/WWA und LED-Streifen mit Animationen.',
    href: '/hardware/#ledbus',
  },
  {
    img: gateway,
    title: 'Komplettgeräte',
    sub: 'MDS-BASIS · MDS-GATEWAY',
    text: 'Fertig bestückte Geräte für den schnellen Einstieg und die Anbindung an die Digitalzentrale.',
    href: '/hardware/#komplett',
  },
];

const modules: [string, string[]][] = [
  ['Schalten & Steuern', ['IFMAG2', 'IFSER2', 'IFSER1P', 'IFMOT2', 'IFREL2']],
  ['Belegtmeldung', ['IFBSP2', 'IFBSP4', 'IFBST2', 'IFBST1P']],
  ['Beleuchtung', ['IFLED4', 'IFLEDB']],
  ['Tasten', ['IFKEY2L', 'IFKEY4']],
  ['Weitere', ['IFGDZ1', 'IFSND1', 'IFKSM1']],
];
---

<SiteLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">Modellbahn Decoder System</span>
        <h1>Ein Decoder für alles&nbsp;– <span class="accent">ohne Kabelsalat</span>.</h1>
        <p class="lead">
          MDS ist ein neues Konzept für stationäre Zubehördecoder: modular, über WLAN verbunden
          und direkt dort platziert, wo Weichen, Signale und Belegtmelder sind.
        </p>
        <div class="cta">
          <a class="btn btn--primary" href="/konzept/">So funktioniert's</a>
          <a class="btn btn--outline" href="/hardware/">Hardware ansehen</a>
        </div>
      </div>
      <div class="hero__img">
        <Image
          src={heroImg}
          alt="MDS Basisadapter ADBAS5, Universaldecoder MDLIF5 und Gehäuse"
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 860px) 92vw, 560px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--3">
        {
          benefits.map((b) => (
            <div class="benefit">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="konzept">
    <div class="container">
      <h2 class="section-title">Systemarchitektur</h2>
      <p class="lead">
        Die Decoder sitzen nahe an den Verbrauchern und Sensoren. Strom kommt über eine
        2-Draht-Ringleitung, die Daten laufen über WLAN – zusätzliche Verkabelung ist nicht nötig.
      </p>
      <div class="concept">
        <Image
          src={systemImg}
          alt="Systemübersicht: Decoder, MDS Controller und MVS"
          widths={[480, 800]}
          sizes="(max-width: 860px) 92vw, 480px"
          class="concept__img"
        />
        <ol class="layers">
          <li>
            <span class="layers__tag">1</span>
            <div>
              <h3>MDS Decoder</h3>
              <p>
                Kleine, modular aufgebaute Zubehördecoder: Weichen, Signale, Belegtmelder,
                Lichtsteuerungen und -animationen mit einem einzigen Decodertyp.
              </p>
            </div>
          </li>
          <li>
            <span class="layers__tag">2</span>
            <div>
              <h3>MDS Controller</h3>
              <p>
                Die Schaltzentrale zwischen Digitalzentrale, Decodern und Benutzer. Läuft auf dem
                Steuer-PC oder auf einem Raspberry Pi und wird im Browser bedient.
              </p>
            </div>
          </li>
          <li>
            <span class="layers__tag">3</span>
            <div>
              <h3>MVS</h3>
              <p>
                Alle Weichen, Signale, Belegtmelder und Decoder werden in MVS erfasst. Der Controller
                holt sich die Konfiguration direkt aus der MVS-Datenbank.
                <a href="https://mvs.lgf.ch">Mehr zu MVS →</a>
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="hardware">
    <div class="container">
      <h2 class="section-title">Hardware</h2>
      <p class="lead">
        Wenige Bausteine, beliebig kombinierbar: Der Decoder wird mit genau den Interface-Modulen
        bestückt, die am Einsatzort gebraucht werden. Eine Firmware kennt alle Kombinationen.
      </p>
      <div class="grid grid--2 hw">
        {
          hardware.map((h) => (
            <a class="card hw__card" href={h.href}>
              <Image src={h.img} alt={h.sub} widths={[320, 480]} sizes="240px" class="hw__img" />
              <div>
                <span class="hw__sub">{h.sub}</span>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
            </a>
          ))
        }
      </div>

      <h3 class="modules__title">Interface-Module im Überblick</h3>
      <div class="modules">
        {
          modules.map(([group, items]) => (
            <div class="modules__group">
              <span class="modules__label">{group}</span>
              <div class="modules__chips">
                {items.map((m) => (
                  <a class="chip" href={`/hardware/${m.toLowerCase()}/`}>{m}</a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="software">
    <div class="container grid grid--2 sw">
      <div>
        <h2 class="section-title">Software</h2>
        <ul class="checks">
          <li>Konfiguration, Abfrage und Schalten im Browser – auf PC, Tablet oder Smartphone</li>
          <li>Firmware-Update und Basiskonfiguration im eingebauten Zustand, ohne Kabel zu lösen</li>
          <li>Betriebsdaten zur Digitalzentrale laufen im Hintergrund</li>
          <li>Einheitliche, sprechende Bezeichnungen aus MVS auf Controller und Decodern</li>
          <li>Hilfsmittel für Fehlersuche in Decoder und Controller eingebaut</li>
        </ul>
      </div>
      <Image
        src={software}
        alt="MDS Software"
        widths={[480, 800]}
        sizes="(max-width: 860px) 92vw, 520px"
        class="sw__img"
      />
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <h2 class="section-title">Neuigkeiten</h2>
          <NewsList entries={news} />
          <p>
            <a href="/news/">Alle Meldungen →</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section section--dark" id="kontakt">
    <div class="container contact">
      <div>
        <h2>Fragen zu MDS?</h2>
        <p class="lead">
          Wir beraten Sie gerne bei der Planung Ihrer Anlage – vom einzelnen Signal bis zum ganzen
          Bahnhof.
        </p>
      </div>
      <a class="btn btn--primary" href={`mailto:${site.contactEmail}?subject=MDS`}>E-Mail schreiben</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    background: linear-gradient(160deg, var(--brand-dark) 0%, #1f3b5c 100%);
    color: #dbe3ec;
    padding-block: clamp(48px, 7vw, 96px);
  }
  .hero h1 {
    color: #fff;
  }
  .hero .eyebrow {
    color: var(--brand-accent);
  }
  .hero .lead {
    color: #c3cfdc;
  }
  .accent {
    color: var(--brand-accent);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero__img img {
    border-radius: var(--radius);
    box-shadow: 0 30px 60px rgb(0 0 0 / 35%);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero .btn--outline {
    border-color: #c3cfdc;
    color: #fff;
  }
  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }

  .benefit h3 {
    color: var(--brand);
    font-size: 1.15rem;
    margin-bottom: 0.25em;
  }
  .benefit p {
    margin: 0;
    color: var(--muted);
  }

  .concept {
    display: grid;
    grid-template-columns: minmax(0, 480px) 1fr;
    gap: 48px;
    align-items: center;
    margin-top: 2rem;
  }
  @media (max-width: 860px) {
    .concept {
      grid-template-columns: 1fr;
    }
  }
  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .layers li {
    display: flex;
    gap: 1rem;
  }
  .layers__tag {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-head);
    font-weight: 700;
  }
  .layers h3 {
    margin-bottom: 0.2em;
  }
  .layers p {
    margin: 0;
    color: var(--muted);
  }

  .hw {
    margin-top: 2rem;
  }
  .hw__card {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.25rem;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .hw__card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .hw__img {
    width: 160px;
    height: 120px;
    object-fit: contain;
  }
  .hw__sub {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .hw__card h3 {
    margin: 0.1em 0 0.3em;
  }
  .hw__card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 520px) {
    .hw__card {
      grid-template-columns: 1fr;
    }
  }

  .modules__title {
    margin-top: 3rem;
  }
  .modules {
    display: grid;
    gap: 0.9rem;
  }
  .modules__group {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1rem;
    align-items: center;
  }
  .modules__label {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .modules__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .modules .chip {
    font-family: var(--font-head);
    font-size: 0.85rem;
    border-color: var(--line);
    background: var(--surface);
    text-decoration: none;
  }
  .modules .chip:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  @media (max-width: 600px) {
    .modules__group {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  .sw {
    align-items: center;
  }
  .sw__img {
    border-radius: var(--radius);
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .checks li {
    padding-left: 1.8rem;
    position: relative;
  }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--brand);
    font-weight: 700;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
</style>
