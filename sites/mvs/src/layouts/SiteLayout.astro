---
import BaseLayout from '@lgf/shared/layouts/BaseLayout.astro';
import { site } from '../site.config';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideAnnouncement?: boolean;
}
const props = Astro.props;
---

<BaseLayout site={site} {...props}>
  <span slot="logo" class="logo">
    <img src="/logo.png" alt="" width="34" height="34" />
    <span class="logo__text"><strong>MVS</strong><small>Modellbahn Verwaltung System</small></span>
  </span>
  <slot />
</BaseLayout>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo__text {
    display: grid;
    line-height: 1.05;
    font-family: var(--font-head);
  }
  .logo__text strong {
    font-size: 1.15rem;
    color: var(--brand-accent);
  }
  .logo__text small {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-dark);
  }
</style>
