---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getNewsForSite, formatDate, type NewsEntry } from '@lgf/shared/lib/news.ts';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const { getNewsForSite } = await import('@lgf/shared/lib/news.ts');
  const { site } = await import('../../site.config');
  const news = await getNewsForSite(site.id);
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: NewsEntry;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

// Vorherige / nächste Meldung
const all = await getNewsForSite(site.id);
const i = all.findIndex((e) => e.id === entry.id);
const newer = i > 0 ? all[i - 1] : undefined;
const older = i < all.length - 1 ? all[i + 1] : undefined;
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogImage={entry.data.cover?.src}
  hideAnnouncement
>
  <article class="section">
    <div class="container article">
      <p><a href="/news/">← Alle Meldungen</a></p>
      <time class="muted" datetime={entry.data.date.toISOString().slice(0, 10)}>
        {formatDate(entry.data.date)}
      </time>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      {
        entry.data.cover && (
          <Image
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? ''}
            widths={[480, 640, 960]}
            sizes="(max-width: 700px) 92vw, 560px"
            loading="eager"
            class="article__cover"
          />
        )
      }
      <div class="prose">
        <Content />
      </div>

      <nav class="article__nav" aria-label="Weitere Meldungen">
        {newer ? <a href={`/news/${newer.id}/`}>← {newer.data.title}</a> : <span />}
        {older && <a href={`/news/${older.id}/`}>{older.data.title} →</a>}
      </nav>
    </div>
  </article>
</SiteLayout>

<style>
  .article {
    max-width: 52em;
  }
  .article h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin-top: 0.3rem;
  }
  .article__cover {
    border-radius: var(--radius);
    margin-block: 1.5rem 2rem;
    width: 100%;
    max-width: 560px;
  }
  .article__nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
</style>
