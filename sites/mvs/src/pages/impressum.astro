---
import SiteLayout from '../layouts/SiteLayout.astro';
import Impressum from '@lgf/shared/components/legal/Impressum.astro';
import { site } from '../site.config';
---

<SiteLayout title="Impressum" hideAnnouncement>
  <section class="section">
    <div class="container">
      <h1>Impressum</h1>
      <Impressum site={site} />
    </div>
  </section>
</SiteLayout>
